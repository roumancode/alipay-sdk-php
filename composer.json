{
	"name": "tailroubin/alipay-sdk",
	"description": "支付宝开放平台第三方 PHP SDK，基于官方最新版本，支持公钥和公钥证书2种模式。",
	"version": "1.1.0",
	"type": "library",
	"keywords": [
		"alipay",
		"支付宝"
	],
	"license": "MIT",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require": {
		"php": ">=8.0",
		"ext-json": "*",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-bcmath": "*"
    },
	"authors": [
		{
			"name": "tailroubin",
			"email": "tailroubin@taidor.com"
		}
	],
	"autoload": {
		"psr-4": {
			"Alipay\\": "src/"
		}
	}
}
